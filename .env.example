# Runtime values only. Keep actual credentials in Coolify, never in the image.
DATABASE_URL=postgresql://plantain_app:CHANGE_ME@POSTGRES_HOST:5432/plantain
REDIS_URL=redis://default:CHANGE_ME@REDIS_HOST:6379/0
REDIS_NAMESPACE=plantain:prod

# Set to the eventual canonical HTTPS origin before enabling Google sign-in.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
CHAT_SOCKET_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required for the currently enabled AI and search features.
GOOGLE_GENERATIVE_AI_API_KEY=
OUTSCRAPER_API_KEY=

# Optional tracing.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com
